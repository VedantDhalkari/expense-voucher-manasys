generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  DIRECTOR
  ACCOUNTS
}

enum Status {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  employeeVouchers Voucher[]      @relation("EmployeeVouchers")
  approvedVouchers Voucher[]      @relation("DirectorApprovals")
  voucherEvents    VoucherEvent[]
}

model Voucher {
  id                   String    @id @default(uuid())
  voucherNumber        String    @unique
  voucherDate          DateTime
  expenseDate          DateTime
  department           String
  expenseTitle         String
  expenseCategory      String
  expenseDescription   String?
  amount               Decimal   @db.Decimal(12, 2)
  employeeSignatureKey String?
  status               Status    @default(DRAFT)
  approvedBy           String?
  directorSignatureKey String?
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relationships
  employeeId String
  employee   User   @relation("EmployeeVouchers", fields: [employeeId], references: [id])
  director   User?  @relation("DirectorApprovals", fields: [approvedBy], references: [id])
  events     VoucherEvent[]

  @@index([voucherNumber])
  @@index([employeeId])
  @@index([status])
  @@index([expenseDate])
  @@index([department])
}

model VoucherEvent {
  id             String   @id @default(uuid())
  voucherId      String
  actorId        String
  action         String
  previousStatus Status?
  newStatus      Status?
  note           String?
  createdAt      DateTime @default(now())

  // Relationships
  voucher Voucher @relation(fields: [voucherId], references: [id])
  actor   User    @relation(fields: [actorId], references: [id])
}
