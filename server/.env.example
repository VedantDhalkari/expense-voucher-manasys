# Environment Variables
PORT=3000

# Security
JWT_SECRET="your_secure_random_jwt_secret"
DEMO_USER_PASSWORD="your_demo_password"

# Database Connection (Local PostgreSQL)
# Must use the expense_app role as per project constraints
DATABASE_URL="postgresql://expense_app:YOUR_PASSWORD@localhost:5432/expense_voucher_db?schema=public"
SHADOW_DATABASE_URL="postgresql://expense_app:YOUR_PASSWORD@localhost:5432/expense_voucher_shadow?schema=public"
